  "repository": "https://github.com/foculoom/aiartifacts",
  "license": "Apache-2.0",
  "keywords": [
    "release",
    "verification",
    "evidence"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Release",
        "shortDescription": "Static release evidence and readback",
